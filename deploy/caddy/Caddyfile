# Compose-stack ingress. The worker's Docker provisioner programs exact-host
# routes through the admin API on :2019; On-Demand TLS issuance is gated by
# the control plane's permission endpoint (fail-closed). `tls internal` keeps
# local development off the public ACME rate limits — swap for real issuance
# (remove the block) when serving public domains.
{
	admin 0.0.0.0:2019
	on_demand_tls {
		ask {$CADDY_PERMISSION_ENDPOINT}
	}
}

https:// {
	tls internal {
		on_demand
	}
	handle {
		respond "hostname-not-routed" 421
	}
}
