# OpenCloud configuration — copy to .env and fill in secrets. NEVER commit .env.
# Full variable reference: docs/INFRASTRUCTURE.md §3.

# --- Runtime ---
ENV=development
LOG_LEVEL=debug

# --- Go API ---
HTTP_ADDR=:8080
METRICS_ADDR=:9090
DATABASE_URL=postgres://opencloud:opencloud@localhost:5432/opencloud?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# --- Auth: Go API (resource server — ADR 0006) ---
# The Go backend issues no tokens; it validates better-auth's JWTs against this
# JWKS endpoint (exposed by the BFF's better-auth `jwt` plugin).
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# Expected JWT iss/aud, validated on every protected route. Empty skips that check
# (dev only); in production BOTH are required — the API refuses to boot without
# them, so iss/aud validation is never a silent no-op. better-auth's jwt plugin
# defaults both claims to its base URL (ADR 0006); set these to match it.
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000

# --- Auth: better-auth (Next.js BFF — ADR 0006) ---
# better-auth is the identity provider, mounted at app/api/auth/[...all]/route.ts.
# Secret must be at least 32 chars; generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000
# The BFF uses the Postgres adapter for its auth.* tables — it reuses DATABASE_URL
# above (better-auth owns the `auth` schema via its migration API).

# --- Social login (better-auth socialProviders — ADR 0006) ---
# Create OAuth apps at console.cloud.google.com and github.com/settings/developers;
# register <BETTER_AUTH_URL>/api/auth/callback/{provider} as the callback.
# Each button stays hidden until both values for that provider are configured.
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GITHUB_CLIENT_ID=change-me
GITHUB_CLIENT_SECRET=change-me

# --- Hosting provisioner (worker only — ADR 0008) ---
# Development uses the in-memory fake. Staging may explicitly select docker
# only after the worker receives a permissioned socket and private Caddy admin
# transport.
PROVISIONER_BACKEND=fake
DOCKER_SOCKET=/var/run/docker.sock
# Keep the Caddy admin endpoint on loopback/private transport; never expose it.
CADDY_API_URL=http://127.0.0.1:2019
CADDY_SERVER_ID=srv0
# Curated operator-built image; customers cannot override this value.
SITE_DEFAULT_IMAGE=opencloud/site-static:phase2

# Optional Hestia fallback. Prefer a scoped access/secret pair; the legacy API
# key remains documented only for migration from an older node.
HESTIA_API_URL=https://hestia-node.example.com:8083
HESTIA_ACCESS_KEY=change-me
HESTIA_SECRET_KEY=change-me
HESTIA_API_KEY=

# --- Customer database data plane (Phase 2, opt-in) ---
# Disabled means API reads remain available but create/delete/reveal return 503.
# These targets MUST be separate from DATABASE_URL (the control-plane DB).
CUSTOMER_DATABASES_ENABLED=false
# Shared by API + worker. Generate externally; never commit a real value:
# openssl rand -base64 32
CUSTOMER_DATABASE_CREDENTIAL_KEY=
# Worker-only admin connection secrets. Use dedicated, least-privileged
# provisioner identities and private network endpoints in production.
CUSTOMER_POSTGRES_ADMIN_URL=
CUSTOMER_MARIADB_ADMIN_DSN=
# Customer-visible endpoints returned only by the one-time reveal route.
CUSTOMER_POSTGRES_HOST=
CUSTOMER_POSTGRES_PORT=5432
CUSTOMER_MARIADB_HOST=
CUSTOMER_MARIADB_PORT=3306
# Production refuses false. Disposable local integration may set false.
CUSTOMER_DATABASE_TLS_REQUIRED=true

# --- Control-plane PostgreSQL backups (opt-in Compose profile) ---
# Generate a fresh external key; do not commit its value:
# openssl rand -base64 32
# The backup service fails closed when this is empty or malformed. Production
# injects it from an orchestrator secret store.
CONTROL_PLANE_BACKUP_KEY=
CONTROL_PLANE_BACKUP_RETENTION_DAYS=14
CONTROL_PLANE_BACKUP_INTERVAL_SECONDS=86400

# --- HTTP hardening ---
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_RPS=10

# --- Frontend (server-side only, not NEXT_PUBLIC_) ---
API_URL=http://localhost:8080

# --- Auth mail (verification + password reset) ---
# log|memory|smtp. ENV=production requires smtp and fails fast when host/from/
# credentials are incomplete. memory is only for automated tests.
MAIL_PROVIDER=log
# SMTP_SECURE=true uses implicit TLS (normally port 465); false requires STARTTLS
# (normally port 587). TLS certificate verification and TLS 1.2+ are mandatory.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=OpenCloud <noreply@example.com>
